{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenSandbox exec authentication v1 response",
  "description": "JSON stdout from a trusted checker that exits with code zero. The response version must match the request. The stdin request schema is available at #/$defs/Request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "allowed"],
  "properties": {
    "version": {"const": "v1"},
    "allowed": {"type": "boolean"}
  },
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "token"],
      "properties": {
        "version": {"const": "v1"},
        "token": {"type": "string", "minLength": 1, "maxLength": 16384, "writeOnly": true}
      }
    }
  }
}
