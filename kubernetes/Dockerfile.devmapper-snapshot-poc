FROM golang:1.25.12 AS builder
WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download
COPY cmd/devmapper-snapshot-poc/ cmd/devmapper-snapshot-poc/
COPY pkg/imagecommitter/ pkg/imagecommitter/
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/image-committer ./cmd/devmapper-snapshot-poc

FROM debian:bookworm-slim
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates dmsetup thin-provisioning-tools \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/image-committer /usr/local/bin/image-committer
ENTRYPOINT ["/usr/local/bin/image-committer"]
